diff --git a/main.py b/main.py
index 6ce5e0c..347ac45 100644
--- a/main.py
+++ b/main.py
@@ -76,22 +76,93 @@ def write_predictions(out_dir: str, target: pd.DataFrame, scores: np.ndarray) ->
 
 
 # ------------------------------- AGENT-OWNED ZONE -----------------------------------
-# Everything below is what the agent rewrites. The seed implementation deliberately
-# contains no ML: it scores every row 0.0, which is a valid-but-worthless submission.
-# Milestone 0 (harness proof) runs exactly this.
-
 def fit_predict(train: pd.DataFrame, target: pd.DataFrame, checkpoint_dir: str) -> np.ndarray:
-    """Fit on `train`, return one score per row of `target` (canonical order).
-
-    Args:
-        train: the training split with all raw log columns.
-        target: the split to score; return exactly len(target) scores.
-        checkpoint_dir: write anything needed to reproduce inference here.
-
-    Returns:
-        np.ndarray of shape (len(target),), finite floats, relative order only.
-    """
-    return np.zeros(len(target), dtype=float)
+    """Investigation pass: inspect schema/cardinalities/censoring, then fall back to a
+    smoothed item-popularity score (no modeling claim, just a safe non-zero baseline)."""
+    import numpy as np
+    import pandas as pd
+    import os
+    import json
+
+    # ---------- 1. schema / cardinality ----------
+    cols = list(train.columns)
+    n_train, n_target = len(train), len(target)
+    n_users = train["user_id"].nunique() if "user_id" in train else -1
+    n_videos = train["video_id"].nunique() if "video_id" in train else -1
+
+    # ---------- 2. per-user impression counts (for lambdarank group feasibility) ----------
+    if "user_id" in train:
+        uc_train = train.groupby("user_id").size()
+        uc_target = target.groupby("user_id").size() if "user_id" in target else pd.Series(dtype=int)
+        uc_stats = (uc_train.min(), uc_train.median(), uc_train.mean(), uc_train.max())
+        tc_stats = (uc_target.min(), uc_target.median(), uc_target.mean(), uc_target.max()) if len(uc_target) else (0,0,0,0)
+    else:
+        uc_stats = tc_stats = (-1,-1,-1,-1)
+
+    # ---------- 3. label prevalence ----------
+    label_rate = train["long_view"].mean() if "long_view" in train else float("nan")
+    aux_rates = {}
+    for c in ["is_click", "is_like", "is_follow", "is_comment", "is_forward"]:
+        if c in train:
+            aux_rates[c] = round(float(train[c].mean()), 4)
+
+    # ---------- 4. date split coverage ----------
+    if "date" in train and "date" in target:
+        tr_dmin, tr_dmax = train["date"].min(), train["date"].max()
+        ta_dmin, ta_dmax = target["date"].min(), target["date"].max()
+    else:
+        tr_dmin = tr_dmax = ta_dmin = ta_dmax = None
+
+    # ---------- 5. watch-time censoring pattern ----------
+    if "play_time_ms" in train and "duration_ms" in train:
+        censored = (train["play_time_ms"] >= train["duration_ms"]).mean()
+        ratio = (train["play_time_ms"] / train["duration_ms"].clip(lower=1)).clip(upper=3)
+        censor_stats = (round(float(censored), 4), round(float(ratio.mean()), 4), round(float(ratio.median()), 4))
+    else:
+        censor_stats = (-1, -1, -1)
+
+    print(f"[investigate] rows train/target={n_train}/{n_target} users={n_users} videos={n_videos}")
+    print(f"[investigate] impressions/user train(min,med,mean,max)={uc_stats} target={tc_stats}")
+    print(f"[investigate] long_view_rate={round(float(label_rate),4)} aux={aux_rates}")
+    print(f"[investigate] date range train=({tr_dmin},{tr_dmax}) target=({ta_dmin},{ta_dmax})")
+    print(f"[investigate] play_time>=duration frac / mean_ratio / median_ratio = {censor_stats}")
+    print(f"[investigate] columns available = {cols}")
+
+    # ---------- fallback scorer: smoothed item popularity ----------
+    global_mean = label_rate if not np.isnan(label_rate) else 0.0
+    alpha = 50.0
+    if "video_id" in train and "long_view" in train:
+        grp = train.groupby("video_id")["long_view"].agg(["sum", "count"])
+        grp["score"] = (grp["sum"] + alpha * global_mean) / (grp["count"] + alpha)
+        pop_map = grp["score"].to_dict()
+    else:
+        pop_map = {}
+
+    if "video_id" in target.columns:
+        scores = target["video_id"].map(pop_map).fillna(global_mean).to_numpy(dtype=float)
+    else:
+        scores = np.full(len(target), global_mean, dtype=float)
+
+    # checkpoint: persist popularity table + diagnostics for reproducibility
+    os.makedirs(checkpoint_dir, exist_ok=True)
+    try:
+        pd.Series(pop_map, name="score").to_csv(os.path.join(checkpoint_dir, "item_popularity.csv"))
+    except Exception as e:
+        print(f"[investigate] checkpoint save skipped: {e}")
+
+    meta = {
+        "n_train": n_train, "n_target": n_target,
+        "n_users": int(n_users) if n_users != -1 else -1,
+        "n_videos": int(n_videos) if n_videos != -1 else -1,
+        "global_mean": float(global_mean),
+    }
+    with open(os.path.join(checkpoint_dir, "meta.json"), "w") as f:
+        json.dump(meta, f)
+
+    if not np.all(np.isfinite(scores)):
+        scores = np.nan_to_num(scores, nan=global_mean, posinf=global_mean, neginf=global_mean)
+
+    return scores
 
 
 # --------------------------- END AGENT-OWNED ZONE -----------------------------------
