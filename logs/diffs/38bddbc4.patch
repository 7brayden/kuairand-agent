+                 checkpoint_dir: str) -> np.ndarray:
+    idxs, vocabs = _encode_all(train, valid, target)
+    y_train = train["long_view"].values.astype(float)
+    y_valid = valid["long_view"].values.astype(float)
+    n = len(train)
+
+    model = FM(vocabs)
+    rng = np.random.RandomState(SEED)
+
+    best_primary = -1.0
+    best_epoch = -1
+    best_snap = None
+    patience_left = PATIENCE
+
+    print(f"[FM] fields={FIELDS} vocabs={vocabs} rows_train={n} rows_valid={len(valid)}")
+
+    for epoch in range(1, MAX_EPOCHS + 1):
+        order = rng.permutation(n)
+        losses = []
+        for start in range(0, n, BATCH):
+            sel = order[start:start + BATCH]
+            idx_batch = {f: idxs["train"][f][sel] for f in FIELDS}
+            y_batch = y_train[sel]
+            loss = model.train_batch(idx_batch, y_batch)
+            losses.append(loss)
+
+        val_idx_batch = {f: idxs["valid"][f] for f in FIELDS}
+        val_scores = model.predict(val_idx_batch)
+        primary, gauc, ndcg = _primary(valid["user_id"].values, y_valid, val_scores)
+        train_loss = float(np.mean(losses))
+
+        print(f"[FM] epoch={epoch:02d} train_logloss={train_loss:.5f} "
+              f"valid_GAUC={gauc:.4f} valid_nDCG5={ndcg:.4f} valid_primary={primary:.4f}")
+
+        if primary > best_primary + 1e-5:
+            best_primary = primary
+            best_epoch = epoch
+            best_snap = model.snapshot()
+            patience_left = PATIENCE
+        else:
+            patience_left -= 1
+            if patience_left <= 0:
+                print(f"[FM] early stop at epoch={epoch}, best_epoch={best_epoch} "
+                      f"best_valid_primary={best_primary:.4f}")
+                break
+    else:
+        print(f"[FM] reached max_epochs={MAX_EPOCHS}, best_epoch={best_epoch} "
+              f"best_valid_primary={best_primary:.4f}")
+
+    if best_snap is not None:
+        model.restore(best_snap)
+
+    os.makedirs(checkpoint_dir, exist_ok=True)
+    np.savez(os.path.join(checkpoint_dir, "fm_model.npz"),
+              bias=model.bias,
+              **{f"W_{f}": model.W[f] for f in FIELDS},
+              **{f"V_{f}": model.V[f] for f in FIELDS})
+
+    target_idx_batch = {f: idxs["target"][f] for f in FIELDS}
+    scores = model.predict(target_idx_batch)
+    scores = np.asarray(scores, dtype=float)
+    scores[~np.isfinite(scores)] = 0.0
+    return scores
 
 
