 # ------------------------------- AGENT-OWNED ZONE -----------------------------------
-# Everything below is what the agent rewrites. The seed implementation deliberately
-# contains no ML: it scores every row 0.0, which is a valid-but-worthless submission.
-# Milestone 0 (harness proof) runs exactly this.
+import numpy as np
+import pandas as pd
+import pickle, os, time
+
+def _sigmoid(x):
+    return 1.0 / (1.0 + np.exp(-np.clip(x, -30, 30)))
+
+def _build_field_encoders(train):
+    """Build label encoders for categorical fields using train only."""
+    fields = ['user_id', 'video_id', 'tab', 'date', 'hourmin_bucket',
+              'duration_bucket', 'is_rand']
+    train = train.copy()
+    train['hourmin_bucket'] = (train['hourmin'] // 100).astype(int)
+    # duration bucket via quantiles on train
+    dq = train['duration_ms'].fillna(0).astype(float)
+    try:
+        bins = np.unique(np.quantile(dq, np.linspace(0, 1, 11)))
+        if len(bins) < 3:
+            bins = np.array([-np.inf, np.inf])
+    except Exception:
+        bins = np.array([-np.inf, np.inf])
+    train['duration_bucket'] = np.digitize(dq, bins)
+
+    encoders = {}
+    offsets = {}
+    cur_offset = 1  # reserve 0 globally as "unknown"
+    for f in fields:
+        vals = train[f].astype('category').cat.categories if False else pd.unique(train[f])
+        mapping = {v: i + 1 for i, v in enumerate(vals)}  # local id 0 reserved unknown
+        encoders[f] = mapping
+        offsets[f] = cur_offset
+        cur_offset += len(mapping) + 1  # +1 for local unknown slot
+    total_features = cur_offset
+    return fields, encoders, offsets, total_features, bins
+
+def _encode(df, fields, encoders, offsets, bins):
+    df = df.copy()
+    df['hourmin_bucket'] = (df['hourmin'] // 100).astype(int)
+    dq = df['duration_ms'].fillna(0).astype(float)
+    df['duration_bucket'] = np.digitize(dq, bins)
+
+    n = len(df)
+    m = len(fields)
+    idx = np.zeros((n, m), dtype=np.int64)
+    for j, f in enumerate(fields):
+        mapping = encoders[f]
+        off = offsets[f]
+        local = df[f].map(mapping).fillna(0).astype(np.int64).values
+        idx[:, j] = off + local
+    return idx
+
+def _gauc(user_ids, scores, labels):
+    df = pd.DataFrame({'u': user_ids, 's': scores, 'y': labels})
+    aucs = []
+    weights = []
+    for u, g in df.groupby('u'):
+        y = g['y'].values
+        if y.min() == y.max():
+            continue
+        s = g['s'].values
+        order = np.argsort(s)
+        ranks = np.empty_like(order, dtype=float)
+        ranks[order] = np.arange(1, len(s) + 1)
+        n_pos = y.sum()
+        n_neg = len(y) - n_pos
+        auc = (ranks[y == 1].sum() - n_pos * (n_pos + 1) / 2.0) / (n_pos * n_neg)
+        aucs.append(auc)
+        weights.append(len(y))
+    if not aucs:
+        return 0.5
+    return float(np.average(aucs, weights=weights))
+
+def _ndcg5(user_ids, scores, labels):
+    df = pd.DataFrame({'u': user_ids, 's': scores, 'y': labels})
+    ndcgs = []
+    for u, g in df.groupby('u'):
+        g = g.sort_values('s', ascending=False)
+        y = g['y'].values[:5]
+        discounts = 1.0 / np.log2(np.arange(2, len(y) + 2))
+        dcg = np.sum(y * discounts)
+        ideal = np.sort(g['y'].values)[::-1][:5]
+        idcg = np.sum(ideal * (1.0 / np.log2(np.arange(2, len(ideal) + 2))))
+        if idcg > 0:
+            ndcgs.append(dcg / idcg)
+        else:
+            ndcgs.append(0.0)
+    if not ndcgs:
+        return 0.0
+    return float(np.mean(ndcgs))
 
 def fit_predict(train: pd.DataFrame, valid: pd.DataFrame, target: pd.DataFrame,
                 checkpoint_dir: str) -> np.ndarray:
-    """Fit on `train`, return one score per row of `target` (canonical order).
-
-    Args:
-        train: the training split (20220408-0421), all raw log columns.
-        valid: the validation split (20220422-0428). **Use this for early stopping and
-            model selection** — the official FM baseline evaluates on it every epoch and
-            stops after 4 rounds without improvement. Never early-stop on `target`.
-        target: the split to score; return exactly len(target) scores.
-        checkpoint_dir: write anything needed to reproduce inference here.
-
-    Note during development `target` IS `valid` (same rows) — that is the organisers'
-    own methodology, matching how the published baseline is tuned. At final evaluation
-    `target` becomes the held-out test split while `valid` stays the validation split,
-    so code that selects on `valid` transfers correctly and code that peeks at `target`'s
-    labels does not.
-
-    Returns:
-        np.ndarray of shape (len(target),), finite floats, relative order only.
-    """
-    return np.zeros(len(target), dtype=float)
+    os.makedirs(checkpoint_dir, exist_ok=True)
+    t0 = time.time()
+
+    fields, encoders, offsets, total_features, bins = _build_field_encoders(train)
+    m = len(fields)
+    k = 16
+    lr = 0.001
+    batch_size = 8192
+    max_epochs = 40
+    patience = 4
+
+    X_train = _encode(train, fields, encoders, offsets, bins)
+    y_train = train['long_view'].astype(float).values
+    X_valid = _encode(valid, fields, encoders, offsets, bins)
+    y_valid = valid['long_view'].astype(float).values
+    valid_users = valid['user_id'].values
+
+    rng = np.random.RandomState(42)
+    w0 = 0.0
+    w = np.zeros(total_features, dtype=np.float64)
+    V = (rng.randn(total_features, k) * 0.01).astype(np.float64)
+
+    # Adam state
+    m_w0 = 0.0; v_w0 = 0.0
+    m_w = np.zeros_like(w); v_w = np.zeros_like(w)
+    m_V = np.zeros_like(V); v_V = np.zeros_like(V)
+    beta1, beta2, eps = 0.9, 0.999, 1e-8
+    t_step = 0
+    l2 = 1e-6
+
+    n = len(X_train)
+    best_score = -np.inf
+    best_epoch = -1
+    best_state = None
+    no_improve = 0
+
+    for epoch in range(1, max_epochs + 1):
+        perm = rng.permutation(n)
+        epoch_loss = 0.0
+        n_batches = 0
+        for start in range(0, n, batch_size):
+            batch_idx = perm[start:start + batch_size]
+            idx_b = X_train[batch_idx]           # (B,m)
+            y_b = y_train[batch_idx]              # (B,)
+            B = len(y_b)
+
+            V_b = V[idx_b]                        # (B,m,k)
+            w_b = w[idx_b]                         # (B,m)
+
+            linear = w0 + w_b.sum(axis=1)
+            sum_emb = V_b.sum(axis=1)              # (B,k)
+            sq_sum = (sum_emb ** 2).sum(axis=1)
+            sum_sq = (V_b ** 2).sum(axis=(1, 2))
+            interaction = 0.5 * (sq_sum - sum_sq)
+
+            logit = linear + interaction
+            pred = _sigmoid(logit)
+            eps_c = 1e-9
+            loss = -np.mean(y_b * np.log(pred + eps_c) + (1 - y_b) * np.log(1 - pred + eps_c))
+            epoch_loss += loss
+            n_batches += 1
+
+            grad_logit = (pred - y_b) / B          # (B,)
+
+            # grad w0
+            g_w0 = grad_logit.sum()
+
+            # grad w: scatter grad_logit to each active feature
+            g_w = np.zeros_like(w)
+            flat_idx = idx_b.reshape(-1)
+            flat_grad = np.repeat(grad_logit, m)
+            np.add.at(g_w, flat_idx, flat_grad)
+            g_w += l2 * w  # reg (approx, only matters where touched effectively via full array but cheap)
+
+            # grad V: for each row i, field e: (sum_emb[i] - V_b[i,e,:]) * grad_logit[i]
+            diff = sum_emb[:, None, :] - V_b       # (B,m,k)
+            g_V_contrib = diff * grad_logit[:, None, None]  # (B,m,k)
+            g_V = np.zeros_like(V)
+            np.add.at(g_V, flat_idx, g_V_contrib.reshape(-1, k))
+            g_V += l2 * V
+
+            # Adam updates
+            t_step += 1
+            lr_t = lr * np.sqrt(1 - beta2 ** t_step) / (1 - beta1 ** t_step)
+
+            m_w0 = beta1 * m_w0 + (1 - beta1) * g_w0
+            v_w0 = beta2 * v_w0 + (1 - beta2) * g_w0 ** 2
+            w0 -= lr_t * m_w0 / (np.sqrt(v_w0) + eps)
+
+            m_w = beta1 * m_w + (1 - beta1) * g_w
+            v_w = beta2 * v_w + (1 - beta2) * g_w ** 2
+            w -= lr_t * m_w / (np.sqrt(v_w) + eps)
+
+            m_V = beta1 * m_V + (1 - beta1) * g_V
+            v_V = beta2 * v_V + (1 - beta2) * g_V ** 2
+            V -= lr_t * m_V / (np.sqrt(v_V) + eps)
+
+        epoch_loss /= max(n_batches, 1)
+
+        # validation
+        V_v = V[X_valid]
+        w_v = w[X_valid]
+        linear_v = w0 + w_v.sum(axis=1)
+        sum_emb_v = V_v.sum(axis=1)
+        sq_sum_v = (sum_emb_v ** 2).sum(axis=1)
+        sum_sq_v = (V_v ** 2).sum(axis=(1, 2))
+        interaction_v = 0.5 * (sq_sum_v - sum_sq_v)
+        val_scores = linear_v + interaction_v
+
+        gauc = _gauc(valid_users, val_scores, y_valid)
+        ndcg5 = _ndcg5(valid_users, val_scores, y_valid)
+        primary = (gauc + ndcg5) / 2.0
+
+        print(f"epoch {epoch:2d} | train_logloss {epoch_loss:.5f} | "
+              f"GAUC {gauc:.4f} | nDCG5 {ndcg5:.4f} | primary {primary:.4f} | "
+              f"elapsed {time.time()-t0:.1f}s")
+
+        if primary > best_score + 1e-5:
+            best_score = primary
+            best_epoch = epoch
+            best_state = (w0, w.copy(), V.copy())
+            no_improve = 0
+        else:
+            no_improve += 1
+            if no_improve >= patience:
+                print(f"Early stopping at epoch {epoch}, best epoch {best_epoch} "
+                      f"with primary {best_score:.4f}")
+                break
+
+    if best_state is None:
+        best_state = (w0, w, V)
+        best_epoch = epoch
+
+    w0, w, V = best_state
+    print(f"Training finished. Best epoch: {best_epoch}, best valid primary: {best_score:.4f}")
+
+    with open(os.path.join(checkpoint_dir, "fm_model.pkl"), "wb") as f:
+        pickle.dump({
+            'w0': w0, 'w': w, 'V': V,
+            'fields': fields, 'encoders': encoders, 'offsets': offsets,
+            'bins': bins, 'total_features': total_features
+        }, f)
+
+    X_target = _encode(target, fields, encoders, offsets, bins)
+    V_t = V[X_target]
+    w_t = w[X_target]
+    linear_t = w0 + w_t.sum(axis=1)
+    sum_emb_t = V_t.sum(axis=1)
+    sq_sum_t = (sum_emb_t ** 2).sum(axis=1)
+    sum_sq_t = (V_t ** 2).sum(axis=(1, 2))
+    interaction_t = 0.5 * (sq_sum_t - sum_sq_t)
+    target_scores = linear_t + interaction_t
+
+    return np.asarray(target_scores, dtype=float)
 
 
