diff --git a/main.py b/main.py
index 6ce5e0c..8ddc671 100644
--- a/main.py
+++ b/main.py
@@ -76,22 +76,85 @@ def write_predictions(out_dir: str, target: pd.DataFrame, scores: np.ndarray) ->
 
 
 # ------------------------------- AGENT-OWNED ZONE -----------------------------------
-# Everything below is what the agent rewrites. The seed implementation deliberately
-# contains no ML: it scores every row 0.0, which is a valid-but-worthless submission.
-# Milestone 0 (harness proof) runs exactly this.
-
-def fit_predict(train: pd.DataFrame, target: pd.DataFrame, checkpoint_dir: str) -> np.ndarray:
-    """Fit on `train`, return one score per row of `target` (canonical order).
+import os
+import numpy as np
+import pandas as pd
+import lightgbm as lgb
 
-    Args:
-        train: the training split with all raw log columns.
-        target: the split to score; return exactly len(target) scores.
-        checkpoint_dir: write anything needed to reproduce inference here.
 
-    Returns:
-        np.ndarray of shape (len(target),), finite floats, relative order only.
+def fit_predict(train: pd.DataFrame, target: pd.DataFrame, checkpoint_dir: str) -> np.ndarray:
+    """LightGBM LambdaRank ranker using user_id x video_id crosses (via categorical
+    trees) plus basic CWM/context features. Optimises ranking directly instead of
+    pointwise logloss, matching the task's within-user ranking evaluation.
     """
-    return np.zeros(len(target), dtype=float)
+    os.makedirs(checkpoint_dir, exist_ok=True)
+
+    # Candidate feature columns: identifiers (crossed implicitly by tree splits)
+    # plus light context/CWM-style fields that are cheap and available.
+    candidate_cols = [
+        "user_id", "video_id", "tab", "duration_ms", "hourmin", "date",
+    ]
+    cols = [c for c in candidate_cols if c in train.columns and c in target.columns]
+    cat_cols = [c for c in ["user_id", "video_id", "tab"] if c in cols]
+
+    label_col = "long_view"
+
+    # --- Build training frame, sorted by user_id so `group` aligns with row order.
+    train_sorted = train.sort_values("user_id", kind="mergesort").reset_index(drop=True)
+
+    # Fix categorical categories using the union of train+target values so that
+    # target-side unseen categories are handled gracefully (become NaN codes,
+    # which LightGBM treats as a valid missing branch, not a crash).
+    cat_categories = {}
+    for c in cat_cols:
+        union_vals = pd.concat(
+            [train_sorted[c].astype("category").cat.categories.to_series(),
+             target[c].astype("category").cat.categories.to_series()],
+            ignore_index=True,
+        ).unique()
+        cat_categories[c] = pd.Index(sorted(union_vals, key=lambda x: (str(type(x)), x)))
+
+    for c in cat_cols:
+        train_sorted[c] = pd.Categorical(train_sorted[c], categories=cat_categories[c])
+
+    X_train = train_sorted[cols].copy()
+    y_train = train_sorted[label_col].astype(int).values
+
+    # Group sizes must follow the row order of X_train (sorted by user_id).
+    group = train_sorted.groupby("user_id", sort=False).size().values
+
+    model = lgb.LGBMRanker(
+        objective="lambdarank",
+        n_estimators=250,
+        num_leaves=31,
+        learning_rate=0.05,
+        min_child_samples=100,
+        subsample=0.8,
+        colsample_bytree=0.8,
+        random_state=0,
+        n_jobs=-1,
+    )
+
+    model.fit(
+        X_train,
+        y_train,
+        group=group,
+        categorical_feature=cat_cols if cat_cols else "auto",
+    )
+
+    model.booster_.save_model(os.path.join(checkpoint_dir, "lgbm_lambdarank.txt"))
+
+    # --- Score target in its existing row order. Never sort/reorder target.
+    X_target = target[cols].copy()
+    for c in cat_cols:
+        X_target[c] = pd.Categorical(X_target[c], categories=cat_categories[c])
+
+    preds = model.predict(X_target)
+    preds = np.asarray(preds, dtype=float)
+    preds = np.nan_to_num(preds, nan=0.0, posinf=0.0, neginf=0.0)
+
+    assert len(preds) == len(target)
+    return preds
 
 
