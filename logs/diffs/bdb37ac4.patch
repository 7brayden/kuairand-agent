---
 main.py | 8 ++++----
 1 file changed, 4 insertions(+), 4 deletions(-)

diff --git a/main.py b/main.py
index 05056e3..c769d32 100644
--- a/main.py
+++ b/main.py
@@ -201,9 +201,9 @@ def fit_predict(train: pd.DataFrame, valid: pd.DataFrame, target: pd.DataFrame,
         metric="ndcg",
         ndcg_eval_at=[5],
         n_estimators=500,
-        learning_rate=0.05,
-        num_leaves=63,
-        min_child_samples=50,
+        learning_rate=0.03,
+        num_leaves=31,
+        min_child_samples=100,
         subsample=0.8,
         colsample_bytree=0.8,
         random_state=0,
@@ -219,7 +219,7 @@ def fit_predict(train: pd.DataFrame, valid: pd.DataFrame, target: pd.DataFrame,
         eval_at=[5],
         categorical_feature=cat_idx,
         callbacks=[
-            lgb.early_stopping(stopping_rounds=30, verbose=False),
+            lgb.early_stopping(stopping_rounds=50, verbose=False),
             lgb.log_evaluation(period=25),
             lgb.record_evaluation(evals_result),
         ],
