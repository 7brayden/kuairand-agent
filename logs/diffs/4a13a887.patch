 # ------------------------------- AGENT-OWNED ZONE -----------------------------------
-# Everything below is what the agent rewrites. The seed implementation deliberately
-# contains no ML: it scores every row 0.0, which is a valid-but-worthless submission.
-# Milestone 0 (harness proof) runs exactly this.
+import numpy as np
+import pandas as pd
+import os, json
+from sklearn.metrics import roc_auc_score
+
+def _sigmoid(x):
+    return 1.0 / (1.0 + np.exp(-np.clip(x, -30, 30)))
+
+def _build_field_map(series):
+    vals = pd.unique(series.dropna())
+    m = {v: i + 1 for i, v in enumerate(vals)}  # 0 reserved for unknown
+    return m
+
+def _encode(series, m):
+    return series.map(m).fillna(0).astype(np.int64).values
+
+def _gauc(df, preds):
+    d = df[['user_id', 'long_view']].copy()
+    d['pred'] = preds
+    aucs, weights = [], []
+    for _, g in d.groupby('user_id'):
+        y = g['long_view'].values
+        if y.min() == y.max():
+            continue
+        try:
+            a = roc_auc_score(y, g['pred'].values)
+        except Exception:
+            continue
+        aucs.append(a)
+        weights.append(len(g))
+    if not aucs:
+        return 0.5
+    return float(np.average(aucs, weights=weights))
+
+def _ndcg5(df, preds):
+    d = df[['user_id', 'long_view']].copy()
+    d['pred'] = preds
+    scores = []
+    for _, g in d.groupby('user_id'):
+        g = g.sort_values('pred', ascending=False)
+        rel = g['long_view'].values[:5]
+        disc = 1.0 / np.log2(np.arange(2, len(rel) + 2))
+        dcg = float((rel * disc).sum())
+        ideal = np.sort(g['long_view'].values)[::-1][:5]
+        idisc = 1.0 / np.log2(np.arange(2, len(ideal) + 2))
+        idcg = float((ideal * idisc).sum())
+        if idcg > 0:
+            scores.append(dcg / idcg)
+        else:
+            scores.append(0.0)
+    return float(np.mean(scores)) if scores else 0.0
 
 def fit_predict(train: pd.DataFrame, valid: pd.DataFrame, target: pd.DataFrame,
-                checkpoint_dir: str) -> np.ndarray:
-    """Fit on `train`, return one score per row of `target` (canonical order).
-
-    Args:
-        train: the training split (20220408-0421), all raw log columns.
-        valid: the validation split (20220422-0428). **Use this for early stopping and
-            model selection** — the official FM baseline evaluates on it every epoch and
-            stops after 4 rounds without improvement. Never early-stop on `target`.
-        target: the split to score; return exactly len(target) scores.
-        checkpoint_dir: write anything needed to reproduce inference here.
-
-    Note during development `target` IS `valid` (same rows) — that is the organisers'
-    own methodology, matching how the published baseline is tuned. At final evaluation
-    `target` becomes the held-out test split while `valid` stays the validation split,
-    so code that selects on `valid` transfers correctly and code that peeks at `target`'s
-    labels does not.
-
-    Returns:
-        np.ndarray of shape (len(target),), finite floats, relative order only.
-    """
-    return np.zeros(len(target), dtype=float)
+                 checkpoint_dir: str) -> np.ndarray:
+    fields = ['user_id', 'video_id', 'tab', 'duration_bucket', 'is_rand']
+    k = 16
+    lr = 0.001
+    batch_size = 8192
+    max_epochs = 40
+    patience = 4
+    l2 = 1e-6
+    rng = np.random.RandomState(0)
+
+    train = train.copy()
+    valid = valid.copy()
+    target = target.copy()
+
+    # duration bucket via quantiles computed on train
+    dur = train['duration_ms'].astype(float).fillna(0.0)
+    try:
+        bins = np.unique(np.quantile(dur.values, np.linspace(0, 1, 21)))
+        if len(bins) < 3:
+            bins = np.array([-np.inf, np.inf])
+    except Exception:
+        bins = np.array([-np.inf, np.inf])
+
+    def add_bucket(df):
+        d = df['duration_ms'].astype(float).fillna(0.0).values
+        df = df.copy()
+        df['duration_bucket'] = np.digitize(d, bins)
+        return df
+
+    train = add_bucket(train)
+    valid = add_bucket(valid)
+    target = add_bucket(target)
+
+    field_maps = {}
+    for f in fields:
+        field_maps[f] = _build_field_map(train[f])
+
+    def encode_df(df):
+        return np.stack([_encode(df[f], field_maps[f]) for f in fields], axis=1)
+
+    X_train = encode_df(train)
+    X_valid = encode_df(valid)
+    X_target = encode_df(target)
+    y_train = train['long_view'].astype(np.float64).values
+
+    vocab_sizes = [len(field_maps[f]) + 1 for f in fields]
+    F = len(fields)
+
+    V = [rng.normal(0, 0.01, size=(vocab_sizes[i], k)) for i in range(F)]
+    W = [np.zeros(vocab_sizes[i]) for i in range(F)]
+    b0 = 0.0
+
+    n = X_train.shape[0]
+    best_score = -1.0
+    best_epoch = -1
+    best_state = None
+    bad_rounds = 0
+
+    def forward(X):
+        B = X.shape[0]
+        V_sel = np.stack([V[f][X[:, f]] for f in range(F)], axis=1)  # (B,F,k)
+        sum_v = V_sel.sum(axis=1)  # (B,k)
+        sq_sum = (V_sel ** 2).sum(axis=1)  # (B,k)
+        inter = 0.5 * (sum_v ** 2 - sq_sum).sum(axis=1)  # (B,)
+        lin = np.zeros(B)
+        for f in range(F):
+            lin += W[f][X[:, f]]
+        logit = b0 + lin + inter
+        return logit, V_sel, sum_v
+
+    print(f"FM training: n_train={n}, fields={fields}, vocab_sizes={vocab_sizes}, k={k}")
+
+    for epoch in range(1, max_epochs + 1):
+        perm = rng.permutation(n)
+        epoch_loss = 0.0
+        nb = 0
+        for start in range(0, n, batch_size):
+            idx = perm[start:start + batch_size]
+            Xb = X_train[idx]
+            yb = y_train[idx]
+            B = Xb.shape[0]
+
+            V_sel = np.stack([V[f][Xb[:, f]] for f in range(F)], axis=1)
+            sum_v = V_sel.sum(axis=1)
+            sq_sum = (V_sel ** 2).sum(axis=1)
+            inter = 0.5 * (sum_v ** 2 - sq_sum).sum(axis=1)
+            lin = np.zeros(B)
+            for f in range(F):
+                lin += W[f][Xb[:, f]]
+            logit = b0 + lin + inter
+            pred = _sigmoid(logit)
+            grad_scale = (pred - yb) / B  # (B,)
+
+            eps = 1e-9
+            loss = -(yb * np.log(pred + eps) + (1 - yb) * np.log(1 - pred + eps)).mean()
+            epoch_loss += loss
+            nb += 1
+
+            db0 = grad_scale.sum()
+            b0 -= lr * db0
+
+            for f in range(F):
+                dW = np.zeros_like(W[f])
+                np.add.at(dW, Xb[:, f], grad_scale)
+                dW += l2 * W[f]
+                W[f] -= lr * dW
+
+                dV = np.zeros_like(V[f])
+                grad_v = grad_scale[:, None] * (sum_v - V_sel[:, f, :])
+                np.add.at(dV, Xb[:, f], grad_v)
+                dV += l2 * V[f]
+                V[f] -= lr * dV
+
+        avg_loss = epoch_loss / max(nb, 1)
+
+        logit_v, _, _ = forward(X_valid)
+        pred_v = _sigmoid(logit_v)
+        gauc_v = _gauc(valid, pred_v)
+        ndcg_v = _ndcg5(valid, pred_v)
+        score = (gauc_v + ndcg_v) / 2.0
+
+        print(f"epoch {epoch:2d} | train_loss={avg_loss:.5f} | valid_GAUC={gauc_v:.4f} "
+              f"valid_nDCG5={ndcg_v:.4f} valid_score={score:.4f}")
+
+        if score > best_score:
+            best_score = score
+            best_epoch = epoch
+            best_state = (b0, [w.copy() for w in W], [v.copy() for v in V])
+            bad_rounds = 0
+        else:
+            bad_rounds += 1
+            if bad_rounds >= patience:
+                print(f"early stopping at epoch {epoch} (best epoch {best_epoch}, "
+                      f"best_score={best_score:.4f})")
+                break
+
+    if best_state is not None:
+        b0, W, V = best_state
+    print(f"final: best_epoch={best_epoch} best_valid_score={best_score:.4f}")
+
+    os.makedirs(checkpoint_dir, exist_ok=True)
+    try:
+        np.savez(os.path.join(checkpoint_dir, "fm_state.npz"),
+                 b0=b0, **{f"W{i}": W[i] for i in range(F)},
+                 **{f"V{i}": V[i] for i in range(F)})
+        with open(os.path.join(checkpoint_dir, "meta.json"), "w") as fp:
+            json.dump({"fields": fields, "best_epoch": best_epoch,
+                       "best_score": best_score}, fp)
+    except Exception as e:
+        print("checkpoint save failed:", e)
+
+    B = X_target.shape[0]
+    V_sel = np.stack([V[f][X_target[:, f]] for f in range(F)], axis=1)
+    sum_v = V_sel.sum(axis=1)
+    sq_sum = (V_sel ** 2).sum(axis=1)
+    inter = 0.5 * (sum_v ** 2 - sq_sum).sum(axis=1)
+    lin = np.zeros(B)
+    for f in range(F):
+        lin += W[f][X_target[:, f]]
+    logit_t = b0 + lin + inter
+    preds_t = _sigmoid(logit_t)
+
+    return preds_t.astype(float)
 
 
