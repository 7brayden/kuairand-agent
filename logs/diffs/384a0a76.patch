diff --git a/main.py b/main.py
index 4f4778c..9f6e731 100644
--- a/main.py
+++ b/main.py
@@ -91,32 +91,111 @@ def write_predictions(out_dir: str, target: pd.DataFrame, scores: np.ndarray) ->
 
 
 # ------------------------------- AGENT-OWNED ZONE -----------------------------------
-# Everything below is what the agent rewrites. The seed implementation deliberately
-# contains no ML: it scores every row 0.0, which is a valid-but-worthless submission.
-# Milestone 0 (harness proof) runs exactly this.
+import os
+import numpy as np
+import pandas as pd
+
+from evaluate import evaluate
+from baseline import FM
+
+FIELDS = ['user_id', 'video_id', 'author_id', 'tab', 'dur_bucket']
+
+
+def _dur_bucket(duration_ms, edges):
+    return np.digitize(duration_ms, edges[1:-1])
+
 
 def fit_predict(train: pd.DataFrame, valid: pd.DataFrame, target: pd.DataFrame,
-                checkpoint_dir: str) -> np.ndarray:
-    """Fit on `train`, return one score per row of `target` (canonical order).
-
-    Args:
-        train: the training split (20220408-0421), all raw log columns.
-        valid: the validation split (20220422-0428). **Use this for early stopping and
-            model selection** — the official FM baseline evaluates on it every epoch and
-            stops after 4 rounds without improvement. Never early-stop on `target`.
-        target: the split to score; return exactly len(target) scores.
-        checkpoint_dir: write anything needed to reproduce inference here.
-
-    Note during development `target` IS `valid` (same rows) — that is the organisers'
-    own methodology, matching how the published baseline is tuned. At final evaluation
-    `target` becomes the held-out test split while `valid` stays the validation split,
-    so code that selects on `valid` transfers correctly and code that peeks at `target`'s
-    labels does not.
-
-    Returns:
-        np.ndarray of shape (len(target),), finite floats, relative order only.
-    """
-    return np.zeros(len(target), dtype=float)
+                 checkpoint_dir: str) -> np.ndarray:
+    os.makedirs(checkpoint_dir, exist_ok=True)
+
+    # --- derive dur_bucket edges from train only ---
+    edges = np.quantile(train['duration_ms'].values, np.linspace(0, 1, 11))
+    edges[0] = -np.inf
+    edges[-1] = np.inf
+    db_train = _dur_bucket(train['duration_ms'].values, edges)
+    db_valid = _dur_bucket(valid['duration_ms'].values, edges)
+    db_target = _dur_bucket(target['duration_ms'].values, edges)
+
+    # --- build integer vocabularies per field, offset for a single embedding table ---
+    codes = {'train': [], 'valid': [], 'target': []}
+    offset = 0
+    for field in FIELDS:
+        if field == 'dur_bucket':
+            v_tr, v_va, v_ta = db_train, db_valid, db_target
+        else:
+            v_tr = train[field].values
+            v_va = valid[field].values
+            v_ta = target[field].values
+        all_vals = np.concatenate([v_tr, v_va, v_ta])
+        uniques, inv = np.unique(all_vals, return_inverse=True)
+        n = len(uniques)
+        inv = inv + offset
+        n_tr, n_va = len(v_tr), len(v_va)
+        codes['train'].append(inv[:n_tr])
+        codes['valid'].append(inv[n_tr:n_tr + n_va])
+        codes['target'].append(inv[n_tr + n_va:])
+        offset += n
+    dim = offset
+    print(f"[setup] vocab dim={dim}, train={len(train)}, valid={len(valid)}, target={len(target)}")
+
+    X_train = np.stack(codes['train'], axis=1).astype(np.int32)
+    X_valid = np.stack(codes['valid'], axis=1).astype(np.int32)
+    X_target = np.stack(codes['target'], axis=1).astype(np.int32)
+    y_train = train['long_view'].values.astype(np.float32)
+    y_valid = valid['long_view'].values.astype(np.float32)
+
+    # --- hyperparameters matching published FM baseline ---
+    k, lr, l2, seed = 16, 0.001, 1e-6, 0
+    epochs, bs, patience = 40, 8192, 4
+
+    model = FM(dim, k=k, lr=lr, l2=l2, seed=seed)
+    rng = np.random.RandomState(seed)
+    n = len(X_train)
+
+    best_primary = -1.0
+    best_epoch = -1
+    best_target_scores = None
+    patience_ctr = 0
+
+    for epoch in range(epochs):
+        perm = rng.permutation(n)
+        losses = []
+        for i in range(0, n, bs):
+            idx = perm[i:i + bs]
+            loss = model.step(X_train[idx], y_train[idx])
+            losses.append(loss)
+        train_loss = float(np.mean(losses))
+
+        val_scores = model.predict(X_valid)
+        metrics = evaluate(valid['user_id'].values, y_valid, val_scores, k=5)
+        primary = metrics['primary']
+        print(f"epoch {epoch} train_loss={train_loss:.4f} valid_GAUC={metrics['GAUC']:.4f} "
+              f"valid_nDCG5={metrics['nDCG@5']:.4f} valid_primary={primary:.4f}")
+
+        if primary > best_primary:
+            best_primary = primary
+            best_epoch = epoch
+            best_target_scores = model.predict(X_target)
+            patience_ctr = 0
+        else:
+            patience_ctr += 1
+            if patience_ctr >= patience:
+                print(f"[stop] early stopping at epoch {epoch}, "
+                      f"best_epoch={best_epoch} best_valid_primary={best_primary:.4f}")
+                break
+    else:
+        print(f"[stop] ran all {epochs} epochs, "
+              f"best_epoch={best_epoch} best_valid_primary={best_primary:.4f}")
+
+    if best_target_scores is None:
+        # safety net: should not happen, but never return None
+        best_target_scores = model.predict(X_target)
+
+    with open(os.path.join(checkpoint_dir, "info.txt"), "w") as f:
+        f.write(f"dim={dim}\nbest_epoch={best_epoch}\nbest_valid_primary={best_primary}\n")
+
+    return best_target_scores.astype(float)
 
 
 # --------------------------- END AGENT-OWNED ZONE -----------------------------------
