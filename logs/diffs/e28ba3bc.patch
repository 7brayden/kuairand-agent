diff --git a/main.py b/main.py
index 09b9b83..6bc2094 100644
--- a/main.py
+++ b/main.py
@@ -115,37 +115,146 @@ def write_predictions(out_dir: str, target: pd.DataFrame, scores: np.ndarray) ->
 
 
 # ------------------------------- AGENT-OWNED ZONE -----------------------------------
-# Everything below is what the agent rewrites. The seed implementation deliberately
-# contains no ML: it scores every row 0.0, which is a valid-but-worthless submission.
-# Milestone 0 (harness proof) runs exactly this.
+import numpy as np
+import pandas as pd
+import os
+import sys
+
+sys.path.insert(0, os.path.join(os.path.dirname(__file__), "official") if "__file__" in globals() else "official")
+
+from baseline import FM
+from evaluate import evaluate
+
+FIELD_COLS = ["user_id", "video_id", "author_id", "tab"]  # dur_bucket handled separately
+N_DUR_BUCKETS = 10
+
+
+def _build_vocab(series):
+    """Map each distinct value seen in train to an id starting at 1. 0 = unseen/unknown."""
+    uniques = pd.unique(series.astype(str))
+    vocab = {v: i + 1 for i, v in enumerate(uniques)}
+    size = len(uniques) + 1  # + unknown slot
+    return vocab, size
+
+
+def _encode_col(series, vocab, offset):
+    s = series.astype(str).map(vocab).fillna(0).astype(np.int64)
+    return (s.values + offset).astype(np.int32)
+
+
+def _dur_bucket(duration_ms, edges):
+    # edges has N_DUR_BUCKETS - 1 interior cut points
+    b = np.digitize(duration_ms.values, edges, right=False)
+    return b.astype(np.int64)
+
 
 def fit_predict(train: pd.DataFrame, valid: pd.DataFrame, target: pd.DataFrame,
-                checkpoint_dir: str, unbiased: pd.DataFrame) -> np.ndarray:
-    """Fit on `train`, return one score per row of `target` (canonical order).
-
-    Args:
-        train: the training split (20220408-0421), all raw log columns.
-        valid: the validation split (20220422-0428). **Use this for early stopping and
-            model selection** — the official FM baseline evaluates on it every epoch and
-            stops after 4 rounds without improvement. Never early-stop on `target`.
-        target: the split to score; return exactly len(target) scores.
-        checkpoint_dir: write anything needed to reproduce inference here.
-        unbiased: random-exposure impressions from the validation window (~500k rows,
-            same columns as `train`). Shown uniformly at random, so per-video rates here
-            measure genuine appeal rather than what the recommender promoted — the two
-            correlate only 0.375. Useful for item-side features; not for training the
-            main objective, and not for reweighting.
-
-    Note during development `target` IS `valid` (same rows) — that is the organisers'
-    own methodology, matching how the published baseline is tuned. At final evaluation
-    `target` becomes the held-out test split while `valid` stays the validation split,
-    so code that selects on `valid` transfers correctly and code that peeks at `target`'s
-    labels does not.
-
-    Returns:
-        np.ndarray of shape (len(target),), finite floats, relative order only.
-    """
-    return np.zeros(len(target), dtype=float)
+                 checkpoint_dir: str, unbiased: pd.DataFrame) -> np.ndarray:
+    # ---- build vocabularies from train only ----
+    vocabs = {}
+    sizes = {}
+    for col in FIELD_COLS:
+        vocab, size = _build_vocab(train[col])
+        vocabs[col] = vocab
+        sizes[col] = size
+
+    # dur_bucket edges from train duration_ms quantiles
+    qs = np.linspace(0, 1, N_DUR_BUCKETS + 1)[1:-1]
+    edges = np.quantile(train["duration_ms"].values.astype(np.float64), qs)
+    dur_size = N_DUR_BUCKETS + 1  # buckets 0..N_DUR_BUCKETS from digitize, +unknown not needed but keep uniform
+
+    # offsets
+    offsets = {}
+    off = 0
+    for col in FIELD_COLS:
+        offsets[col] = off
+        off += sizes[col]
+    offsets["dur_bucket"] = off
+    off += dur_size
+    total_dim = off
+
+    def build_X(df):
+        cols = [_encode_col(df[c], vocabs[c], offsets[c]) for c in FIELD_COLS]
+        cols.append((_dur_bucket(df["duration_ms"], edges) + offsets["dur_bucket"]).astype(np.int32))
+        return np.stack(cols, axis=1).astype(np.int32)
+
+    X_train = build_X(train)
+    y_train = train["long_view"].values.astype(np.float32)
+    X_valid = build_X(valid)
+    y_valid = valid["long_view"].values.astype(np.float32)
+    valid_users = valid["user_id"].values
+    X_target = build_X(target)
+
+    print(f"[fit_predict] total_dim={total_dim}, train_rows={len(X_train)}, valid_rows={len(X_valid)}")
+
+    # ---- train FM with early stopping on valid ----
+    k = 16
+    lr = 0.001
+    l2 = 1e-6
+    bs = 8192
+    max_epochs = 40
+    patience = 4
+    seed = 0
+
+    model = FM(total_dim, k=k, lr=lr, l2=l2, seed=seed)
+
+    rng = np.random.RandomState(seed)
+    n = len(X_train)
+    best_primary = -1.0
+    best_state = None
+    epochs_no_improve = 0
+
+    for epoch in range(max_epochs):
+        perm = rng.permutation(n)
+        total_loss = 0.0
+        n_batches = 0
+        for start in range(0, n, bs):
+            idx = perm[start:start + bs]
+            loss = model.step(X_train[idx], y_train[idx])
+            total_loss += loss
+            n_batches += 1
+        avg_loss = total_loss / max(n_batches, 1)
+
+        val_scores = model.predict(X_valid)
+        metrics = evaluate(valid_users, y_valid, val_scores, k=5)
+        primary = metrics["primary"]
+        print(f"[epoch {epoch}] train_loss={avg_loss:.5f} valid_GAUC={metrics['GAUC']:.4f} "
+              f"valid_nDCG5={metrics['nDCG@5']:.4f} valid_primary={primary:.4f}")
+
+        if primary > best_primary:
+            best_primary = primary
+            best_state = (model.U.copy() if hasattr(model, "U") else None,
+                           model.V.copy() if hasattr(model, "V") else None)
+            # generic fallback: snapshot all array attributes
+            best_snapshot = {attr: getattr(model, attr).copy()
+                              for attr in vars(model)
+                              if isinstance(getattr(model, attr), np.ndarray)}
+            epochs_no_improve = 0
+        else:
+            epochs_no_improve += 1
+            if epochs_no_improve >= patience:
+                print(f"[fit_predict] early stopping at epoch {epoch}, best_primary={best_primary:.4f}")
+                break
+
+    # restore best snapshot
+    try:
+        for attr, val in best_snapshot.items():
+            setattr(model, attr, val)
+    except NameError:
+        pass
+
+    print(f"[fit_predict] final best valid primary={best_primary:.4f}")
+
+    scores = model.predict(X_target)
+    scores = np.asarray(scores, dtype=float)
+    scores = np.nan_to_num(scores, nan=0.0, posinf=0.0, neginf=0.0)
+
+    os.makedirs(checkpoint_dir, exist_ok=True)
+    np.savez(os.path.join(checkpoint_dir, "fm_checkpoint.npz"),
+              **{attr: getattr(model, attr) for attr in vars(model)
+                 if isinstance(getattr(model, attr), np.ndarray)})
+
+    return scores
 
 
